{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main Diffchecker window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-open-file",
    "allow-save-file",
    "allow-get-version",
    "allow-list-recent-files",
    "allow-open-recent-file",
    "allow-list-history",
    "allow-add-history",
    "allow-remove-history",
    "allow-clear-history",
    "allow-get-save-history",
    "allow-set-save-history"
  ]
}
